# URL base de la API (O3). Vite sustituye import.meta.env.VITE_API_BASE por
# este texto al construir y en desarrollo, así que acaba tal cual en el JS que
# se descarga el navegador: cualquiera puede leerlo con F12. Por eso NO es un
# secreto y este fichero se sube al repo. Nada secreto en variables VITE_ (si
# hiciera falta una clave privada, iría en el servidor, no aquí).
#
# Sobrescribirla sólo en tu máquina: .env.local (ignorado por *.local en
# .gitignore).
VITE_API_BASE=http://localhost:3000/api
